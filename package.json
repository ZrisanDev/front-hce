{
  "name": "front-hce",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --cwd apps/shell dev",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "bun --cwd apps/shell build",
    "build:all": "bun --cwd apps/shell build && bun --cwd apps/mf-productos build && bun --cwd apps/mf-compras build && bun --cwd apps/mf-ventas build && bun --cwd apps/mf-kardex build",
    "start": "bun --cwd apps/shell start",
    "lint": "eslint"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
